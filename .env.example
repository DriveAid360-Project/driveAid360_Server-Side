# DriveAid360 Server Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# Server Configuration
PORT=8080

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/driveaid360
DATABASE_USERNAME=driveaid360
DATABASE_PASSWORD=your_secure_database_password_here

# JWT Configuration
# Generate a strong secret key (minimum 256 bits for HS256)
# Example: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Admin Credentials (Development only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# File Upload
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
